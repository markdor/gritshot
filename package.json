{
	"name": "gritshot",
	"private": true,
	"description": "Turn your Garmin activities into customized photo cards with statistics overlay.",
	"license": "AGPL-3.0-only",
	"author": "markdor",
	"repository": {
		"type": "git",
		"url": "https://github.com/markdor/gritshot"
	},
	"engines": {
		"node": ">=24"
	},
	"version": "1.6.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "npm run test:fixtures && vitest",
		"test:coverage": "npm run test:fixtures && vitest run --coverage",
		"test:fixtures": "node --strip-types tests/fixtures/generate-zip-fixtures.ts",
		"parse-fit-fixtures": "node --strip-types tests/fixtures/parse-fit-fixtures.ts",
		"test": "npm run test:fixtures && npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"docker:build": "docker build -t gritshot .",
		"docker:dev": "docker compose up --build",
		"docker:test": "playwright test --config=playwright.docker.config.ts",
		"db:generate": "drizzle-kit generate"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/archiver": "^7.0.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.0",
		"@types/yauzl": "^2.10.3",
		"@vitest/browser-playwright": "^4.1.7",
		"@vitest/coverage-v8": "^4.1.6",
		"archiver": "^7.0.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"vite": "^8.0.14",
		"vitest": "^4.1.6",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@fontsource/barlow-condensed": "^5.2.8",
		"better-auth": "^1.6.11",
		"better-sqlite3": "^12.10.0",
		"drizzle-orm": "^0.45.2",
		"fit-file-parser": "^3.0.1",
		"garmin-connect": "^1.6.2",
		"nodemailer": "^8.0.10",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"sharp": "^0.34.5",
		"yauzl": "^3.3.1"
	}
}
