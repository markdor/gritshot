{
	"name": "gritshot",
	"private": true,
	"description": "Turn your Garmin activities into customized photo cards with statistics overlay.",
	"license": "AGPL-3.0-only",
	"author": "markdor",
	"repository": {
		"type": "git",
		"url": "https://github.com/markdor/gritshot"
	},
	"engines": {
		"node": ">=24"
	},
	"version": "1.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "npm run test:fixtures && vitest",
		"test:coverage": "npm run test:fixtures && vitest run --coverage",
		"test:fixtures": "node --strip-types tests/fixtures/generate-zip-fixtures.ts",
		"parse-fit-fixtures": "node --strip-types tests/fixtures/parse-fit-fixtures.ts",
		"test": "npm run test:fixtures && npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/archiver": "^7.0.0",
		"@types/node": "^24",
		"@types/yauzl": "^2.10.3",
		"@vitest/browser-playwright": "^4.1.0",
		"@vitest/coverage-v8": "^4.1.2",
		"archiver": "^7.0.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.0",
		"vitest-browser-svelte": "^2.0.2"
	},
	"dependencies": {
		"@fontsource/barlow-condensed": "^5.2.8",
		"fit-file-parser": "^2.3.3",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"sharp": "^0.34.5",
		"yauzl": "^3.2.1"
	}
}
